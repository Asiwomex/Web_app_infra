# ── Terraform ─────────────────────────────────────────────────────────────────

# Local plugin/module cache — re-created by terraform init
.terraform/

# State files — remote state is in S3; local copies must never be committed
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Crash logs
crash.log
crash.*.log

# Override files (local dev overrides, not for version control)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local CLI config
.terraformrc
terraform.rc

# ── Sensitive variable files ───────────────────────────────────────────────────
# Uncomment if any tfvars file ever holds secrets (DB passwords, API keys, etc.)
# Current tfvars are safe to commit — passwords are generated by random_password.
# *.tfvars
# *.tfvars.json

# ── AWS ───────────────────────────────────────────────────────────────────────
.aws/
*.pem
*.key

# ── Claude Code session data ──────────────────────────────────────────────────
.claude/

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Diagram backups (auto-generated by DrawIO) ────────────────────────────────
*.bkp
*.bak
